+static void gc_ephemeron_activate(JSRuntime *rt, void *ptr)
+{
+    JSEphemeronKey *key = gc_ephemeron_key(rt->ephemeron, ptr);
+    JSEphemeronPending *entry = key->pending;
+    key->pending = NULL;
+    while (entry) {
+        JS_MarkValue(rt, entry->record->value, gc_scan_incref_child);
+        entry = entry->next;
+    }
+}
