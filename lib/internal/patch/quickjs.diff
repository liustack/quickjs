+/* Lazy error stacks: making an error only records each stack frame (the
+   function name, the bytecode and the pc), and the 'stack' text is
+   formatted the first time it is needed, with the same bytes.
+
+   A pending stack is an autoinit property with the id
+   JS_AUTOINIT_ID_BACKTRACE, writable and configurable like the string it
+   stands for, so that every generic path that meets it stops. It does not
+   go through the generic autoinit protocol, which formats before it knows
+   what the caller wants and copies a shared shape for each object:
+
+   - Reading it (get, getOwnPropertyDescriptor, get_prop_string) formats
+     the text first. If that fails, the read throws and nothing changes, so
+     a later read can try again. Then the property becomes the plain data
+     property, and the object takes the hashed shape an error whose stack
+     was formatted at once has. The record holds that shape.
+   - Assigning or defining a new value replaces it without formatting it.
+   - Assigning through an object that has the error as its prototype treats
+     it as the writable data property it stands for. */
+
+#define JS_BACKTRACE_PROP_FLAGS (JS_PROP_WRITABLE | JS_PROP_CONFIGURABLE)
+
+typedef struct JSBacktraceFrame {
+    JSString *func_name; /* NULL for <anonymous> */
+    JSFunctionBytecode *b; /* NULL for a native function */
+    uint32_t pc; /* the pc_value build_backtrace gives to find_line_num */
+} JSBacktraceFrame;
+
+struct JSBacktrace {
+    int count;
+    /* the hashed shape the object had with the formatted stack when the
+       stack was recorded, or NULL. Holding it keeps it in the shape hash
+       table for when the stack is formatted. */
+    JSShape *formatted;
+    JSBacktraceFrame frames[0];
+};
+
+/* the string get_prop_string() reads for the name of 'fun', as a new
+   reference, or NULL where it returns NULL. It runs no JS code. */
+static JSString *js_backtrace_func_name(JSContext *ctx, JSValueConst fun)
+{
+    JSObject *p;
+    JSProperty *pr;
+    JSShapeProperty *prs;
+    JSValueConst val;
+
+    if (JS_VALUE_GET_TAG(fun) != JS_TAG_OBJECT)
+        return NULL;
+    p = JS_VALUE_GET_OBJ(fun);
+    prs = find_own_property(&pr, p, JS_ATOM_name);
+    if (!prs) {
+        p = p->shape->proto;
+        if (!p)
+            return NULL;
+        prs = find_own_property(&pr, p, JS_ATOM_name);
+        if (!prs)
+            return NULL;
+    }
+    if ((prs->flags & JS_PROP_TMASK) != JS_PROP_NORMAL)
+        return NULL;
+    val = pr->u.value;
+    if (JS_VALUE_GET_TAG(val) != JS_TAG_STRING)
+        return NULL;
+    return JS_VALUE_GET_STRING(JS_DupValue(ctx, val));
+}
+
+static void js_backtrace_free(JSContext *ctx, JSBacktrace *bt)
+{
+    int i;
+
+    for(i = 0; i < bt->count; i++) {
+        if (bt->frames[i].func_name)
+            JS_FreeValue(ctx, JS_MKPTR(JS_TAG_STRING, bt->frames[i].func_name));
+        if (bt->frames[i].b)
+            JS_FreeValue(ctx, JS_MKPTR(JS_TAG_FUNCTION_BYTECODE, bt->frames[i].b));
+    }
+    if (bt->formatted)
+        js_free_shape(ctx->rt, bt->formatted);
+    js_free_rt(ctx->rt, bt);
+}
+
+static void js_backtrace_mark(JSRuntime *rt, JSBacktrace *bt,
+                              JS_MarkFunc *mark_func)
+{
+    int i;
+
+    for(i = 0; i < bt->count; i++) {
+        if (bt->frames[i].b)
+            mark_func(rt, &bt->frames[i].b->header);
+    }
+    if (bt->formatted)
+        mark_func(rt, &bt->formatted->header);
+}
+
+static void js_backtrace_memory_usage(JSMemoryUsage *s, JSMemoryUsage_helper *hp,
+                                      JSShapeProperty *prs, JSProperty *pr)
+{
+    JSBacktrace *bt;
+    int i;
+
+    if (prs->atom == JS_ATOM_NULL ||
+        (prs->flags & JS_PROP_TMASK) != JS_PROP_AUTOINIT ||
+        js_autoinit_get_id(pr) != JS_AUTOINIT_ID_BACKTRACE)
+        return;
+    bt = pr->u.init.opaque;
+    s->memory_used_count++;
+    s->memory_used_size += sizeof(*bt) + bt->count * sizeof(bt->frames[0]);
+    for(i = 0; i < bt->count; i++) {
+        if (bt->frames[i].func_name)
+            compute_jsstring_size(bt->frames[i].func_name, hp);
+    }
+}
+
+/* the hash add_property() gives a hashed shape with the properties of
+   'sh', where property 'idx' has the flags 'flags' */
+static uint32_t js_backtrace_shape_hash(JSShape *sh, int idx, int flags)
+{
+    JSShapeProperty *prs;
+    uint32_t h;
+    int i;
+
+    h = shape_initial_hash(sh->proto);
+    prs = get_shape_prop(sh);
+    for(i = 0; i < sh->prop_count; i++, prs++)
+        h = shape_hash(shape_hash(h, prs->atom), i == idx ? flags : prs->flags);
+    return h;
+}
+
+/* whether 'sh1' has the prototype and the properties of 'sh', where
+   property 'idx' has the flags 'flags' */
+static BOOL js_backtrace_same_shape(JSShape *sh1, JSShape *sh, int idx,
+                                    int flags)
+{
+    JSShapeProperty *prs1, *prs;
+    int i;
+
+    if (sh1->proto != sh->proto || sh1->prop_count != sh->prop_count)
+        return FALSE;
+    prs1 = get_shape_prop(sh1);
+    prs = get_shape_prop(sh);
+    for(i = 0; i < sh->prop_count; i++, prs1++, prs++) {
+        if (prs1->atom != prs->atom ||
+            prs1->flags != (i == idx ? flags : prs->flags))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+/* a new reference to the hashed shape with the properties of the hashed
+   shape 'sh', where property 'idx' has the flags 'flags'. It is found in
+   the shape hash table. Otherwise, as add_property() does, 'sh' changes in
+   place if 'in_place' is set and only one object has it, or a clone of
+   'sh' is hashed. Return NULL if there is no memory for the clone. */
+static JSShape *js_backtrace_hashed_shape(JSContext *ctx, JSShape *sh,
+                                          int idx, int flags, BOOL in_place)
+{
+    JSRuntime *rt = ctx->rt;
+    JSShape *sh1;
+    uint32_t h;
+
+    h = js_backtrace_shape_hash(sh, idx, flags);
+    for(sh1 = rt->shape_hash[get_shape_hash(h, rt->shape_hash_bits)];
+        sh1 != NULL; sh1 = sh1->shape_hash_next) {
+        if (sh1 != sh && sh1->hash == h &&
+            js_backtrace_same_shape(sh1, sh, idx, flags))
+            return js_dup_shape(sh1);
+    }
+    if (in_place && js_rc(sh)->ref_count == 1) {
+        js_shape_hash_unlink(rt, sh);
+        get_shape_prop(sh)[idx].flags = flags;
+        sh->hash = h;
+        js_shape_hash_link(rt, sh);
+        return js_dup_shape(sh);
+    }
+    sh1 = js_clone_shape(ctx, sh);
+    if (!sh1)
+        return NULL;
+    get_shape_prop(sh1)[idx].flags = flags;
+    sh1->hash = h;
+    sh1->is_hashed = TRUE;
+    js_shape_hash_link(rt, sh1);
+    return sh1;
+}
+
+/* give 'p' the shape 'sh', taking over the reference to it, and release
+   the shape 'p' had. Return -1, with 'sh' released and 'p' unchanged, if
+   there is no memory to resize the property array. */
+static int js_backtrace_set_shape(JSContext *ctx, JSObject *p, JSShape *sh)
+{
+    JSShape *old_sh = p->shape;
+    JSProperty *new_prop;
+
+    if (sh->prop_size != old_sh->prop_size) {
+        new_prop = js_realloc(ctx, p->prop, sizeof(p->prop[0]) * sh->prop_size);
+        if (!new_prop) {
+            js_free_shape(ctx->rt, sh);
+            return -1;
+        }
+        p->prop = new_prop;
+    }
+    p->shape = sh;
+    js_free_shape(ctx->rt, old_sh);
+    return 0;
+}
+
+/* replace the pending stack at 'prs', a property of 'p', with the data
+   property 'val', which is freed on error. With 'shared' set, 'p' gets a
+   hashed shape other objects can share: the one an error whose stack was
+   formatted at once has, if 'p' has not changed since. Otherwise 'p' gets
+   a shape of its own, as js_shape_prepare_update() gives it, for a caller
+   that changes the property next. Return -1, with 'p' unchanged, if there
+   is no memory for a shape. */
+static int js_backtrace_settle(JSContext *ctx, JSObject *p,
+                               JSShapeProperty *prs, JSValue val, BOOL shared)
+{
+    JSShape *sh = p->shape, *new_sh;
+    JSProperty *pr;
+    int idx, flags;
+
+    idx = prs - get_shape_prop(sh);
+    flags = prs->flags & ~JS_PROP_TMASK;
+    if (shared && sh->is_hashed) {
+        new_sh = js_backtrace_hashed_shape(ctx, sh, idx, flags, TRUE);
+        if (!new_sh || js_backtrace_set_shape(ctx, p, new_sh) < 0) {
+            JS_FreeValue(ctx, val);
+            return -1;
+        }
+    } else {
+        if (js_shape_prepare_update(ctx, p, &prs)) {
+            JS_FreeValue(ctx, val);
+            return -1;
+        }
+        prs->flags = flags;
+    }
+    pr = &p->prop[idx];
+    js_autoinit_free(ctx->rt, pr);
+    pr->u.value = val;
+    return 0;
+}
+
+/* format a pending stack as build_backtrace() does */
+static JSValue js_backtrace_format(JSContext *ctx, JSBacktrace *bt)
+{
+    JSBacktraceFrame *f;
+    DynBuf dbuf;
+    const char *str;
+    JSValue val;
+    int i;
+
+    js_dbuf_init(ctx, &dbuf);
+    for(i = 0; i < bt->count; i++) {
+        f = &bt->frames[i];
+        dbuf_putstr(&dbuf, "    at ");
+        if (!f->func_name) {
+            dbuf_putstr(&dbuf, "<anonymous>");
+        } else {
+            /* NULL means there was no memory for the text */
+            str = JS_ToCString(ctx, JS_MKPTR(JS_TAG_STRING, f->func_name));
+            if (!str)
+                goto fail;
+            dbuf_putstr(&dbuf, str[0] == '\0' ? "<anonymous>" : str);
+            JS_FreeCString(ctx, str);
+        }
+
+        if (f->b) {
+            JSFunctionBytecode *b = f->b;
+            int line_num1, col_num1;
+
+            if (b->has_debug) {
+                line_num1 = find_line_num(ctx, b, f->pc, &col_num1);
+                str = JS_AtomToCString(ctx, b->debug.filename);
+                if (!str)
+                    goto fail;
+                dbuf_printf(&dbuf, " (%s", str);
+                JS_FreeCString(ctx, str);
+                if (line_num1 != 0)
+                    dbuf_printf(&dbuf, ":%d:%d", line_num1, col_num1);
+                dbuf_putc(&dbuf, ')');
+            }
+        } else {
+            dbuf_putstr(&dbuf, " (native)");
+        }
+        dbuf_putc(&dbuf, '\n');
+    }
+    dbuf_putc(&dbuf, '\0');
+    if (dbuf_error(&dbuf)) {
+        dbuf_free(&dbuf);
+        return JS_ThrowOutOfMemory(ctx);
+    }
+    val = JS_NewString(ctx, (char *)dbuf.buf);
+    dbuf_free(&dbuf);
+    return val;
+ fail:
+    dbuf_free(&dbuf);
+    return JS_EXCEPTION;
+}
+
+/* JS_AutoInitProperty() for a pending stack: format it and store the
+   text. If formatting fails, return -1 and leave the stack pending. */
+static int js_backtrace_instantiate(JSContext *ctx, JSObject *p,
+                                    JSProperty *pr, JSShapeProperty *prs)
+{
+    JSValue val;
+
+    val = js_backtrace_format(ctx, pr->u.init.opaque);
+    if (JS_IsException(val))
+        return -1;
+    return js_backtrace_settle(ctx, p, prs, val, TRUE);
+}
+
+/* JS_AutoInitProperty() for JS_SetPropertyInternal() assigning to an own
+   property: the value is replaced, so a pending stack is dropped and not
+   formatted. */
+static int js_backtrace_autoinit_set(JSContext *ctx, JSObject *p, JSAtom prop,
+                                     JSProperty *pr, JSShapeProperty *prs)
+{
+    if (js_autoinit_get_id(pr) != JS_AUTOINIT_ID_BACKTRACE)
+        return JS_AutoInitProperty(ctx, p, prop, pr, prs);
+    return js_backtrace_settle(ctx, p, prs, JS_UNDEFINED, TRUE);
+}
+
+/* JS_AutoInitProperty() for JS_DefineProperty() with the flags 'flags'. A
+   definition that gives a value, a getter or a setter drops a pending
+   stack. One that keeps the value formats it. */
+static int js_backtrace_autoinit_define(JSContext *ctx, JSObject *p,
+                                        JSAtom prop, JSProperty *pr,
+                                        JSShapeProperty *prs, int flags)
+{
+    int cur, mask;
+
+    if (js_autoinit_get_id(pr) != JS_AUTOINIT_ID_BACKTRACE)
+        return JS_AutoInitProperty(ctx, p, prop, pr, prs);
+    if (flags & (JS_PROP_HAS_GET | JS_PROP_HAS_SET))
+        return js_backtrace_settle(ctx, p, prs, JS_UNDEFINED, FALSE);
+    if (flags & JS_PROP_HAS_VALUE) {
+        /* JS_DefineProperty() sets the value, and changes the flags in
+           place when the shape is the object's own */
+        cur = prs->flags & JS_PROP_C_W_E;
+        mask = (flags >> JS_PROP_HAS_SHIFT) & JS_PROP_C_W_E;
+        return js_backtrace_settle(ctx, p, prs, JS_UNDEFINED,
+                                   ((cur & ~mask) | (flags & mask)) == cur);
+    }
+    return js_backtrace_instantiate(ctx, p, pr, prs);
+}
+
+/* record the n frames of the stack of 'p' as a pending stack. 'p' is an
+   extensible Error object without a 'stack' property. Return FALSE if
+   there is no memory for that. 'p' may then have a 'stack' property
+   holding undefined. */
+static BOOL js_backtrace_lazy(JSContext *ctx, JSObject *p, int backtrace_flags,
+                              int n)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf;
+    JSBacktrace *bt;
+    JSBacktraceFrame *f;
+    JSFunctionBytecode *b;
+    JSProperty *pr;
+    JSShape *sh, *pending, *formatted;
+    int idx;
+
+    bt = js_malloc_rt(rt, sizeof(*bt) + n * sizeof(bt->frames[0]));
+    if (!bt)
+        return FALSE;
+    /* add the property as build_backtrace() does, so that the object gets
+       the shape it has with a formatted stack, then retag it as pending */
+    pr = add_property(ctx, p, JS_ATOM_stack, JS_BACKTRACE_PROP_FLAGS);
+    if (!pr) {
+        js_free_rt(rt, bt);
+        return FALSE;
+    }
+    pr->u.value = JS_UNDEFINED;
+    sh = p->shape;
+    idx = sh->prop_count - 1;
+    formatted = NULL;
+    if (sh->is_hashed) {
+        pending = js_backtrace_hashed_shape(ctx, sh, idx,
+                                            JS_BACKTRACE_PROP_FLAGS | JS_PROP_AUTOINIT,
+                                            FALSE);
